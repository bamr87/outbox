{
  "version": 1,
  "meta": {
    "name": "Scout Line",
    "description": "cron -> kill switch -> rate limit -> scout agent -> one tracking issue + a repository_dispatch carrying its number.",
    "repo": "bamr87/lifehacker.dev"
  },
  "nodes": [
    {
      "id": "tc",
      "type": "trigger.cron",
      "position": {
        "x": 40,
        "y": 120
      },
      "config": {
        "cron": "10 21 * * *"
      }
    },
    {
      "id": "g",
      "type": "gate.enablement",
      "position": {
        "x": 240,
        "y": 120
      },
      "config": {
        "variable": "CONTENT_SCOUT_ENABLED"
      }
    },
    {
      "id": "rl",
      "type": "rate.limiter",
      "position": {
        "x": 440,
        "y": 120
      },
      "config": {
        "maxPerDay": 2
      }
    },
    {
      "id": "scout",
      "type": "agent.claude",
      "position": {
        "x": 640,
        "y": 120
      },
      "config": {
        "promptRef": ".factory/prompts/scout.md",
        "model": "claude-opus-5-5",
        "maxTurns": 30
      }
    },
    {
      "id": "iss",
      "type": "sink.create_issue",
      "position": {
        "x": 840,
        "y": 120
      },
      "config": {
        "titleHint": "Scouted: <topic>"
      }
    },
    {
      "id": "rd",
      "type": "sink.repository_dispatch",
      "position": {
        "x": 1040,
        "y": 120
      },
      "config": {
        "targetRepo": "bamr87/lifehacker.dev",
        "eventType": "content-scouted",
        "tokenSecret": "FLEET_TOKEN"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "tc",
        "port": "out"
      },
      "to": {
        "node": "g",
        "port": "in"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "g",
        "port": "out"
      },
      "to": {
        "node": "rl",
        "port": "in"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "rl",
        "port": "out"
      },
      "to": {
        "node": "scout",
        "port": "in"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "scout",
        "port": "out"
      },
      "to": {
        "node": "iss",
        "port": "in"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "scout",
        "port": "out"
      },
      "to": {
        "node": "rd",
        "port": "in"
      }
    }
  ]
}
