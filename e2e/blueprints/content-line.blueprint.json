{
  "version": 1,
  "meta": {
    "name": "Content Line",
    "description": "cron -> kill switch -> rate limit -> one Claude agent -> one draft PR.",
    "repo": "bamr87/lifehacker.dev"
  },
  "nodes": [
    {
      "id": "tc",
      "type": "trigger.cron",
      "position": {
        "x": 40,
        "y": 120
      },
      "config": {
        "cron": "40 22 * * *"
      }
    },
    {
      "id": "g",
      "type": "gate.enablement",
      "position": {
        "x": 240,
        "y": 120
      },
      "config": {
        "variable": "CONTENT_FACTORY_ENABLED"
      }
    },
    {
      "id": "rl",
      "type": "rate.limiter",
      "position": {
        "x": 440,
        "y": 120
      },
      "config": {
        "maxPerDay": 2
      }
    },
    {
      "id": "a",
      "type": "agent.claude",
      "position": {
        "x": 640,
        "y": 120
      },
      "config": {
        "promptRef": ".factory/prompts/content-line.md",
        "model": "claude-opus-5-5",
        "maxTurns": 40
      }
    },
    {
      "id": "pr",
      "type": "sink.open_pr",
      "position": {
        "x": 840,
        "y": 120
      },
      "config": {
        "branchHint": "factory/content-*"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "tc",
        "port": "out"
      },
      "to": {
        "node": "g",
        "port": "in"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "g",
        "port": "out"
      },
      "to": {
        "node": "rl",
        "port": "in"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "rl",
        "port": "out"
      },
      "to": {
        "node": "a",
        "port": "in"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "a",
        "port": "out"
      },
      "to": {
        "node": "pr",
        "port": "in"
      }
    }
  ]
}
